<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FarePlanSA" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand colours applied to Material 3 theme -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/bg_app</item>
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="android:statusBarColor">@color/brand_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.FarePlanSA" parent="Base.Theme.FarePlanSA" />

    <!-- Theme to deactivate the system splash screen on Android 12+ -->
    <style name="Theme.FarePlanSA.Splash" parent="Theme.FarePlanSA">
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>