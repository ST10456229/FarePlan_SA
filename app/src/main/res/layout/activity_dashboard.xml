<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello, Traveller!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A2B4C"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnNewTrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Plan New Trip"
        android:backgroundTint="#F27A41"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Trips"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1A2B4C"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No trips yet. Tap '+ Plan New Trip' to get started."
        android:textSize="14sp"
        android:textColor="#888888"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTrips"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"/>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:backgroundTint="#E74C3C"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp"/>

</LinearLayout>