<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/cbItineraryDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvItineraryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visit Table Mountain"
                android:textColor="@color/brand_navy"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvItineraryNotes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bring water"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvItineraryDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10/12/2026 · 09:00"
                android:textColor="@color/brand_primary"
                android:textSize="11sp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnItineraryEdit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="Edit"/>

        <ImageButton
            android:id="@+id/btnItineraryDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Delete"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>